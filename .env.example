# Copia este archivo a .env.local y pega tu clave de https://console.groq.com/keys
# IMPORTANTE: nunca uses el prefijo NEXT_PUBLIC_ para esta variable.
GROQ_API_KEY=tu_clave_aqui

# Opcional: sobrescribe los modelos por defecto si Groq los renombra o depreca.
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
